# 环境变量配置文件
# 复制此文件为 .env.local 并填入实际值

# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 仅用于服务器端

# 网站配置
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="好運跑班"

# 可选：外部服务集成
# NEXTAUTH_SECRET=your-secret-for-nextauth
# NEXTAUTH_URL=http://localhost:3000

# 可选：文件上传配置
NEXT_PUBLIC_MAX_FILE_SIZE=10  # MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 可选：分析服务
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# 开发相关
NEXT_PUBLIC_DEBUG_MODE=false

# 部署相关
NODE_ENV=development