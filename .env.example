# 環境變數設定檔
# 請複製為 .env.local 並填入實際值，切勿提交任何正式金鑰

# Supabase 設定
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 僅用於伺服器端
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# 商店訂單與信用卡付款（僅伺服器端）
ORDER_ACCESS_SECRET=replace-with-a-long-random-secret
GOOGLE_FORMS_WEBHOOK_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_webhook_signing_secret

# 台灣金流（綠界或藍新擇一申請；僅伺服器端）
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=

# 網站設定
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="好運跑班"

# 選用：外部服務整合
# NEXTAUTH_SECRET=your-secret-for-nextauth
# NEXTAUTH_URL=http://localhost:3000

# 選用：檔案上傳設定
NEXT_PUBLIC_MAX_FILE_SIZE=10  # MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 選用：分析服務
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# 開發相關
NEXT_PUBLIC_DEBUG_MODE=false

# 部署相關
NODE_ENV=development
